{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@dd/engine": ["../client/src/engine/index.ts"],
      "@dd/engine/*": ["../client/src/engine/*"],
      "@dd/net/*": ["../client/src/net/*"],
      "@dd/game/*": ["../client/src/game/*"]
    }
  },
  "include": ["src", "test"]
}
