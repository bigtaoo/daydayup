# Cloudflare Workers static-assets response headers (wrangler/client.jsonc).
#
# index.html and version.json must never be served from a stale edge/browser cache, or the
# auto-reload in src/platform/web/autoReload.ts would keep reading the pre-deploy hash and a
# reload would just re-fetch the old page. Everything under /assets/ carries a Rollup content
# hash in its filename, so those are safe to cache forever.
/index.html
  Cache-Control: no-cache, must-revalidate
/version.json
  Cache-Control: no-cache, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
