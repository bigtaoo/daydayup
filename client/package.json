{
  "name": "daydayup-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "DayDayUp client — PixiJS v8 top-down shooter vertical slice",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:wechat": "tsc --noEmit && vite build --config vite.wechat.config.js",
    "preview": "vite preview --port 4173",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:open:android": "cap open android",
    "cap:add:ios": "cap add ios",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
