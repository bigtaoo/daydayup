{
  // Static hosting (Cloudflare Workers static assets) for the animator authoring
  // tool, served at dd-animator.gamestao.com. Same Cloudflare account/zone as the
  // game client (see wrangler/client.jsonc) and funny's gamestao.com tools.
  //
  // Build (outputs tools/animator/dist):
  //   npm run build -w tools/animator
  // Deploy (from repo root, reads this file):
  //   npx wrangler deploy -c wrangler/animator.jsonc
  //
  // routes[].custom_domain=true auto-provisions DNS + edge cert on first deploy.
  "name": "daydayup-animator",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "../tools/animator/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "dd-animator.gamestao.com", "custom_domain": true }
  ]
}
